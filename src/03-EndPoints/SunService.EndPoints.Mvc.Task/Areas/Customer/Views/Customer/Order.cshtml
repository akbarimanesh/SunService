@using Framework
@using SunService.Domain.Core.SunServices.HService.DTOs
@using SunService.Domain.Core.SunServices.HService.Enums
<div class="breadcrumb-area">
    <h1>سلام،  <span>@User.Claims.First(x => x.Type == "FullName").Value</span>!</h1>
    @{
        ViewData["Title"] = "خانه > سفارش ها";
    }
</div>
@model List<OrderDto>

<div class="notification-alert alert alert-success alert-dismissible fade show" role="alert">
    <p><span>@User.Claims.First(x => x.Type == "FullName").Value</span>،بهترین خدمات رو با ما تجربه کنید.</p>
    <button type="button" class="close" data-bs-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>



<div class="packages-box">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <h2>سفارش ها</h2>
    <div class="packages-table table-responsive">
        <table class="table table-bordered">
            <thead>
                <tr>
                    
                    <th>شناسه سفارش</th>
                    <th>خدمات</th>
                    <th>تاریخ ثبت</th>
                    
                    <th>وضعیت</th>
                    <th>جزئیات سفارش</th>
                    <th>پیشنهادها</th>
                    <th>عملیات</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (var order in Model)
                {
                    <tr>
                      
                        <td>@order.Id</td>
                        
                        <td>@order.HomeServiceTitle </td>
                        <td>@order.CreateAt.ToPersianString("yyyy/MM/dd")</td>
                        


                        <td>@EnumExtensionMethods.GetEnumDisplayName(order.OrderHomeServiceStatus) </td>
                        <td>
                          
                            <a asp-area="Customer" asp-controller="Customer" asp-action="Show" asp-route-Id="@order.Id" class="status">نمایش</a>
                        </td>
                        
                        <td>
                            <a asp-area="Customer" asp-controller="Customer" asp-action="Offer" asp-route-Id="@order.Id" class="status">پیشنهادها</a>
                        </td>
                        <td>

                            @if (order.OrderHomeServiceStatus == OrderHomeServiceStatusEnum.FinishingWork)
                            {
                                <span class="text-success">پایان کار</span>
                            }
                            else if(order.OrderHomeServiceStatus==OrderHomeServiceStatusEnum.ExpetToCome)
                            {
                                <input type="hidden" name="offerId" value="@order.OfferId" />
                                <a asp-area="Customer" asp-controller="Customer" asp-action="Payment" asp-route-offerId="@order.OfferId" class="status">اتمام کار</a>

                            }
                            
                            
                        </td>
                        
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
