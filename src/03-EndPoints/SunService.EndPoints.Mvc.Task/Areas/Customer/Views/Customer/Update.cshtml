<div class="breadcrumb-area">
    <h1>سلام،  <span>@User.Claims.First(x => x.Type == "FullName").Value</span>!</h1>
    @{
        ViewData["Title"] = "خانه > ویرایش پروفایل";
    }
</div>


<div class="notification-alert alert alert-success alert-dismissible fade show" role="alert">
    <p><span>@User.Claims.First(x => x.Type == "FullName").Value</span>،بهترین خدمات رو با ما تجربه کنید.</p>
    <button type="button" class="close" data-bs-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>


<div class="my-profile-box">
    <h3>ویرایش پروفایل</h3>
    <div class="bar"></div>
    <div class="profile-outer-area">
        <div class="profile-outer">
            <div class="profileButton">
                <input class="profileButton-input" type="file" name="attachments[]" accept="image/*, application/pdf" id="upload" multiple />
                <label class="profileButton-button ripple-effect" for="upload">عکس پروفایل</label>
                <span class="profileButton-file-name"></span>
            </div>
            <div class="text">حداکثر اندازه فایل 1 مگابایت، حداقل ابعاد: 330x300 و فایل های مناسب jpg و png.</div>
        </div>
    </div>
    <form>
        <div class="row align-items-center">
            <div class="col-xl-6 col-lg-12 col-md-12">
                <div class="form-group">
                    <label>نام</label>
                    <input type="text" class="form-control" >
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 col-md-12">
                <div class="form-group">
                    <label> نام خانوادگی</label>
                    <input type="text" class="form-control" >
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 col-md-12">
                <div class="form-group">
                    <label> ایمیل</label>
                    <input type="email" class="form-control" >
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 col-md-12">
                <div class="form-group">
                    <label>موبایل</label>
                    <input type="text" class="form-control" placeholder="09121234567">
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 col-md-12">
                <div class="form-group">
                    <label>شماره کارت</label>
                    <input type="text" class="form-control" >
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 col-md-12">
                <div class="form-group">
                    <label>شماره شبا</label>
                    <input type="text" class="form-control" placeholder="IR870570028180010653892101">
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 col-md-12">
                <div class="form-group">
                    <label>موجودی</label>
                    <input type="text" class="form-control" placeholder="موجودی" >
                </div>
            </div>
            <div class="col-xl-6 col-lg-12 col-md-12">
                <div class="form-group">
                    <label>تاریخ</label>
                    <input type="text" class="form-control" placeholder="12.08.1400" data-jdp>
                </div>
            </div>
            <div class="col-lg-12 col-md-12">
                <div class="form-group select-group">
                    <label>شهر</label>
                    <select class="form-select form-control">
                        <option value="1">تهران</option>
                        <option value="2">کرج</option>
                        <option value="3">شیراز</option>
                        <option value="4">مشهد</option>
                        <option value="5">تبریز</option>
                    </select>
                </div>
            </div>
            
           
            <div class="col-lg-12 col-md-12">
                <div class="form-group">
                    <label>آدرس</label>
                    <input type="text" class="form-control" placeholder="آدرس">
                </div>
            </div>
          
        
            <div class="col-lg-12 col-md-12">
                <button type="submit" class="default-btn">ارسال <i class="flaticon-send"></i></button>
            </div>
        </div>
    </form>
</div>