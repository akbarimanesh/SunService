@using Framework
@using SunService.Domain.Core.SunServices.HService.DTOs
@using SunService.Domain.Core.SunServices.HService.Entities
<div class="breadcrumb-area">
    <h1>سلام،  <span>@User.Claims.First(x => x.Type == "FullName").Value</span>!</h1>
    @{
        ViewData["Title"] = "خانه > پیشنهادها";
    }
</div>
@model List<OfferDto>

<div class="notification-alert alert alert-success alert-dismissible fade show" role="alert">
    <p><span>@User.Claims.First(x => x.Type == "FullName").Value</span>،بهترین خدمات رو با ما تجربه کنید.</p>
    <button type="button" class="close" data-bs-dismiss="alert" aria-label="Close">
        <span aria-hidden="true">&times;</span>
    </button>
</div>


<div class="resume-alerts-area">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    <div class="resume-alerts-table table-responsive">
        <h3>پیشنهادها</h3>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th scope="col">شناسه پیشنهاد</th>
                    
                    <th scope="col">کارشناس </th>
                    <th scope="col">قیمت پیشنهادی</th>
                    <th scope="col">تاریخ پیشنهاد</th>
                    <th scope="col">تاریخ اتمام کار</th>
                    <th scope="col">توضیحات</th>
                    @* <th scope="col">امتیاز کاربر</th> *@
                    <th scope="col">عملیات</th>
                    
                </tr>
            </thead>
            <tbody>
                @foreach (var offer in Model)
                {
                    <tr>
                       
                        <td>@offer.Id</td>
                        <td>
                            <input type="hidden" name="id" value="@offer.ExpertId" />
                            <input type="hidden" name="homeserviceId" value="@offer.HomeserviceId" />

                            <a asp-area="Customer" asp-controller="Customer" asp-action="ProfileExpert" asp-route-id="@offer.ExpertId" asp-route-homeserviceId="@offer.HomeserviceId" class="expert-profile-link">
                                

                                @offer.ExpertFullName
                            </a>
                        </td>
                       
                        <td>@offer.PriceOffer</td>
                        <td>@offer.OfferDate.ToPersianString("yyyy/MM/dd")</td>
                        <td>@offer.CompletionDate.ToPersianString("yyyy/MM/dd")</td>
                        <td>@offer.Description</td>

                       @*  <td>
                            <span class="stars">
                                @{
                                    int roundedRating = (int)Math.Round(offer.AverageRating);
                                }
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <span class="@(i <= roundedRating ? "star-filled" : "star-empty")">★</span>
                                }
                            </span>
                        </td> *@

                        <style>
                            .star-filled {
                                color: gold;
                                font-size: 18px;
                            }

                            .star-empty {
                                color: lightgray;
                                font-size: 18px;
                            }
                        </style>

                        <td>
                            @if (offer.StateOffer == true)
                            {
                                <span class="text-success">پذیرفته شده</span>
                            }
                            else if (offer.StateOffer == false)
                            {
                                <span class="text-danger">رد شده</span>
                            }
                            else
                            {
                                <ul class="option-list">
                                    <li>
                                        <form asp-area="Customer" asp-controller="Customer" asp-action="AcceptOffer" method="get">
                                            <input type="hidden" name="id" value="@offer.Id" />
                                           
                                            <button type="submit" class="option-btn d-inline-block" data-bs-toggle="tooltip" data-bs-placement="top" title="پذیرفتن">
                                                <i class="ri-check-line"></i>
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
