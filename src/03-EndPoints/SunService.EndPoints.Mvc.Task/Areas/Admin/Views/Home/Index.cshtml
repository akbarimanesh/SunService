@using Framework
@using SunService.Domain.Core.SunServices.HService.DTOs
@using SunService.EndPoints.Mvc.Task.Areas.Admin.Models
@{
    ViewData["Title"] = "پیشخوان";
}
@model StatisticsViewModel

<div class="portlet-body">
    <div class="row">
        <div class="col-lg-3 col-6">
            <div class="stat-box use-cyan shadow">
                <a href="#">
                    <div class="stat">
                        <div class="counter-down"><div class="num">@Model.statisticsDataDto.CustomerCount</div></div>
                        <div class="h3">تعداد مشتری ها</div>
                    </div><!-- /.stat -->
                    <div class="visual">
                        <i class="icon-people"></i>
                    </div><!-- /.visual -->
                </a>
            </div><!-- /.stat-box -->
        </div><!-- /.col-lg-3 -->
        <div class="col-lg-3 col-6">
            <div class="stat-box use-blue shadow">
                <a href="#">
                    <div class="stat">
                        <div class="counter-down"><div class="num">@Model.statisticsDataDto.ExpertCount</div></div>
                        <div class="h3">تعداد کارشناس ها</div>
                    </div><!-- /.stat -->
                    <div class="visual">
                        <i class="icon-briefcase"></i>
                    </div><!-- /.visual -->
                </a>
            </div><!-- /.stat-box -->
        </div><!-- /.col-lg-3 -->
        <div class="col-lg-3 col-6">
            <div class="stat-box use-green shadow">
                <a href="#">
                    <div class="stat">
                        <div class="counter-down"><div class="num">@Model.statisticsDataDto.OrderCount</div></div>
                        <div class="h3">تعداد سفارش ها</div>
                    </div><!-- /.stat -->
                    <div class="visual">
                        <i class="icon-basket"></i>
                    </div><!-- /.visual -->
                </a>
            </div><!-- /.stat-box -->
        </div><!-- /.col-lg-3 -->
        <div class="col-lg-3 col-6">
            <div class="stat-box use-purple shadow">
                <a href="#">
                    <div class="stat">
                        <div class="counter-down"><div class="num">@Model.statisticsDataDto.OfferCount</div></div>
                        <div class="h3">تعداد پیشنهادها</div>
                    </div><!-- /.stat -->
                    <div class="visual">
                        <i class="icon-bell"></i>
                    </div><!-- /.visual -->
                </a>
            </div><!-- /.stat-box -->
        </div><!-- /.col-lg-3 -->
    </div>
</div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-lg-12 -->

<div class="row align-items-center">
    <div class="col-xl-6 col-lg-12 col-md-12">
        <div class="portlet box shadow">
            <div class="portlet-heading">
                <div class="portlet-title">
                    <h3 class="title">
                        <i class="icon-speech"></i>
                        آخرین سفارش ها
                    </h3>
                </div><!-- /.portlet-title -->
                <div class="table-responsive">

                    <table class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th><i class="icon-energy"></i></th>
                                <th>سفارش دهنده</th>
                                <th>تاریخ</th>
                                <th>خدمات</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model.orderDtos)
                            {
                                <tr>

                                    <td>
                                        <i class="fas fa-arrow-up text-success"></i>
                                    </td>
                                    <td>@order.CustomerFullName</td>
                                    <td>@order.CreateAt.ToPersianString("yyyy/MM/dd")</td>
                                    <td>@order.HomeServiceTitle </td>
                                    
                                   


                                    <td>@EnumExtensionMethods.GetEnumDisplayName(order.OrderHomeServiceStatus) </td>


                                   
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>


               

            </div>
        </div>
    </div>
    <div class="col-xl-6 col-lg-12 col-md-12">
        <div class="portlet box shadow">
            <div class="portlet-heading">
                <div class="portlet-title">
                    <h3 class="title">
                        <i class="icon-speech"></i>
                        آخرین پیشنهاد ها
                    </h3>
                </div><!-- /.portlet-title -->
                <div class="table-responsive">

                    <table class="table table-bordered table-striped table-hover">
                        <thead>
                            <tr>
                                <th><i class="icon-energy"></i></th>
                                <th>کارشناس</th>
                                <th>تاریخ</th>
                                <th>خدمات</th>

                                <th>قیمت پیشنهادی</th>
                                <th>وضعیت</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var offer in Model.offerDtos)
                            {
                                <tr>

                                    <td>
                                        <i class="fas fa-arrow-up text-success"></i>
                                    </td>
                                    <td>@offer.ExpertFullName </td>
                                    <td>@offer.OfferDate.ToPersianString("yyyy/MM/dd")</td>
                                    <td>@offer.HomeServiceTitle</td>
                                    <td>@offer.PriceOffer </td>
                                    
                                    

                                    <td>
                                        @if (offer.StateOffer.HasValue && offer.StateOffer.Value)
                                        {
                                            <span class="badge bg-success">پذیرفته شده</span>
                                        }
                                        else if (offer.StateOffer.HasValue && !offer.StateOffer.Value)
                                        {
                                            <span class="badge bg-warning">پذیرفته نشده</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">نامشخص</span>
                                        }

                                    </td>


                                </tr>
                            }
                        </tbody>
                    </table>
                </div>


                
            </div>
        </div>
    </div>
</div>