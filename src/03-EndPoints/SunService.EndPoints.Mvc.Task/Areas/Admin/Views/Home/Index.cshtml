@using SunService.Domain.Core.SunServices.HService.DTOs
@{
    ViewData["Title"] = "پیشخوان";
}
@model StatisticsDataDto

        <div class="portlet-body">
            <div class="row">
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-cyan shadow">
                        <a href="#">
                            <div class="stat">
                                <div class="counter-down"><div class="num">@Model.CustomerCount</div></div>
                                <div class="h3">تعداد مشتری ها</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                                <i class="icon-people"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-blue shadow">
                        <a href="#">
                            <div class="stat">
                                <div class="counter-down"><div class="num">@Model.ExpertCount</div></div>
                                <div class="h3">تعداد کارشناس ها</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                        <i class="icon-briefcase"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-green shadow">
                        <a href="#">
                            <div class="stat">
                                <div class="counter-down"><div class="num">@Model.OrderCount</div></div>
                                <div class="h3">تعداد سفارش ها</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                        <i class="icon-basket"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
                <div class="col-lg-3 col-6">
                    <div class="stat-box use-purple shadow">
                        <a href="#">
                            <div class="stat">
                                <div class="counter-down"><div class="num">@Model.OfferCount</div></div>
                                <div class="h3">تعداد پیشنهادها</div>
                            </div><!-- /.stat -->
                            <div class="visual">
                        <i class="icon-bell"></i>
                            </div><!-- /.visual -->
                        </a>
                    </div><!-- /.stat-box -->
                </div><!-- /.col-lg-3 -->
            </div>
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-lg-12 -->
