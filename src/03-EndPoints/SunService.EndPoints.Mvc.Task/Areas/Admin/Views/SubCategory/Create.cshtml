@using SunService.Domain.AppServices.SunServices.HService
@using SunService.Domain.Core.SunServices.HService.AppServices
@using SunService.Domain.Core.SunServices.HService.Entities
@{
    ViewData["Title"] = "سان سرویس > مدیریت زیر دسته بندی ها > ایجاد زیر دسته بندی ها";

}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model SubCategory
@inject ICategoryAppServices CategoryAppService;
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
<div class="col-lg-12">
    <div class="portlet box shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    زیر دسته بندی ها
                </h3>
            </div><!-- /.portlet-title -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            <div class="top-buttons-box mb-2">
            </div>
            <div class="row">
                <form enctype="multipart/form-data" id="simple-form" role="form" method="post">
                    <div class="form-body">
                        <div class="form-group">
                            <div class="input-group">
                                <input asp-for="Title" asp-controller="SubCategory" asp-action="Create" class="form-control" type="text" placeholder="عنوان">
                            </div>
                        </div>
                       
                        <div class="form-group">
                            <div class="input-group">
                                <select asp-for="CategoryId" asp-controller="SubCategory" asp-action="Create" class="form-select">
                                    @foreach (var category in await CategoryAppService.GetAllCategories(default))
                                    {
                                        <option value="@category.Id">@category.Title</option>
                                    }
                                </select>
                            </div>
                        </div>
                        

                       @*   <div class="form-group relative">
                            <input asp-for="User.ProfileImgFile" type="file" class="form-control">
                            <label>آپلود عکس</label>
                            <div class="input-group round">
                                <input type="text" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
                                <span class="input-group-btn">
                                    <button type="button" class="btn btn-success">
                                        <i class="icon-picture"></i>
                                        آپلود عکس
                                        <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                                    </button>
                                </span>
                            </div><!-- /.input-group -->
                            <div class="help-block"></div>
                        </div>
 *@
                    </div>
                    <hr>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-success">
                            <i class="icon-check"></i>
                            ذخیره
                        </button>
                        <a asp-action="Index" class="btn btn-warning">
                            بازگشت
                        </a>
                    </div>
                </form>
            </div>
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-lg-12 -->
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}