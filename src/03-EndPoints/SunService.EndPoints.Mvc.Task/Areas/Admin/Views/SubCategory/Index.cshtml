@using SunService.Domain.Core.SunServices.HService.AppServices
@using SunService.Domain.Core.SunServices.HService.DTOs
@using SunService.Domain.Core.SunServices.UserS.DTOs
@{
    ViewData["Title"] = "سان سرویس > مدیریت زیر دسته بندی ها > لیست زیر دسته بندی ها";
}
@model List<SubCategoryDto>
@inject ICategoryAppServices CategoryAppService;
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="col-lg-12">
    <div class="portlet box shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    زیر دسته بندی ها
                </h3>
            </div><!-- /.portlet-title -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            <div class="top-buttons-box mb-2">
                <a class="btn btn-success" asp-controller="SubCategory" asp-action="Create">
                    <i class="icon-plus"></i>
                    افزودن
                    <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                </a>
            </div>
            <div class="row">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped" id="subcategory-table">
                        <thead>
                            <tr>
                                @*  <th class="p-low"><input type="checkbox" id="btn-check-all-toggle"></th> *@

                                <th>شناسه</th>
                                <th>عنوان</th>
                                <th>دسته بندی</th>
                                


                                <th>عملیات</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var subcategory in Model)
                            {
                                <tr>
                                    @*  <td><input type="checkbox"></td> *@
                                    <td>@subcategory.Id</td>

                                    @*  @if (string.IsNullOrEmpty(user.ImagePath))
                                    {
                                        <td><img style="border-radius : 50%" src="~/AdminTemplate/images/user/placeholder.jpg" width="80" height="80" /></td>
                                    }
                                    else
                                    {
                                        <td><img style="border-radius : 50%" src="@user.ImagePath" width="80" height="80" /></td>
                                    } *@

                                    <td>@subcategory.Title</td>
                                    <td>@subcategory.CategoryName</td>

                                    <td>
                                        <a asp-controller="SubCategory" asp-action="Update" asp-route-Id="@subcategory.Id" class="btn btn-info">ویرایش</a>
                                        <a onclick="return confirm('آیا از حذف این کاربر اطمینان دارید؟')" asp-action="Delete" asp-route-Id="@subcategory.Id" class="btn btn-danger">حذف</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-lg-12 -->
@section Scripts
{
    <script src="~/AdminTemplate/plugins/data-table/js/jquery.dataTables.min.js"></script>
    <script src="~/AdminTemplate/js/pages/datatable.js"></script>
}
