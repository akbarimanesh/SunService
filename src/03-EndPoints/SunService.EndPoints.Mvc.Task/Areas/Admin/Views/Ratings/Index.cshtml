@using Framework
@using SunService.Domain.Core.SunServices.HService.DTOs
@using SunService.Domain.Core.SunServices.UserS.DTOs
@using SunService.Domain.Core.SunServices.UserS.Enums
@{
    ViewData["Title"] = "سان سرویس > مدیریت کامنت ها > لیست کامنت ها ";
}
@model List<RatingDto>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="col-lg-12">
    <div class="portlet box shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    کامنت 
                </h3>
            </div><!-- /.portlet-title -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            @* <div class="top-buttons-box mb-2">
                <a class="btn btn-success" asp-controller="Orders" asp-action="Create">
                    <i class="icon-plus"></i>
                    افزودن
                    <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                </a>
            </div> *@
            <div class="row">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped" id="rating-table">
                        <thead>
                            <tr>


                                <th>شناسه</th>
                                <th>کارشناس </th>
                                <th>مشتری</th>
                                <th>خدمات</th>
                                <th>امتیاز</th>
                                <th>کامنت</th>

                                <th>تاریخ ایجاد</th>
                                <th>وضعیت</th>
                                <th>عملیات</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rating in Model)
                            {
                                <tr>

                                    <td>@rating.Id</td>
                                    <td>@rating.ExpertFullName</td>
                                    <td>@rating.CustomerFullName </td>
                                    <td>@rating.HomeServiceTitle </td>
                                    <td>
                                        <span class="stars">
                                            @for (int i = 1; i <= 5; i++)
                                            {
                                                <span class="@(i <= rating.Score ? "star-filled" : "star-empty")">★</span>
                                            }
                                        </span>
                                    </td>

                                    <style>
                                        .star-filled {
                                            color: gold;
                                            font-size: 18px;
                                        }

                                        .star-empty {
                                            color: lightgray;
                                            font-size: 18px;
                                        }
                                    </style>

                                    <td>@rating.Comment </td>
                                    <td>@rating.CreatedAt.ToPersianString("yyyy/MM/dd")</td>


                                    <td>@EnumExtensionMethods.GetEnumDisplayName(rating.Status)</td>

                                    <td>
                                        <input type="hidden" name="id" value="@rating.Id" />
                                        <a class="btn btn-success" asp-controller="Ratings" asp-action="Confirmation" value="@StatuseRating.aproved" asp-route-id="@rating.Id">تایید</a>
                                        <a class="btn btn-danger" asp-controller="Ratings" asp-action="Rejected" value="@StatuseRating.Rejected" asp-route-id="@rating.Id">رد</a>
                                    </td>
                                   
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-lg-12 -->

@section Scripts
{
    <script src="~/AdminTemplate/plugins/data-table/js/jquery.dataTables.min.js"></script>
    <script src="~/AdminTemplate/js/pages/datatable.js"></script>
}

