@using Framework
@using SunService.Domain.Core.SunServices.UserS.DTOs
@{
    ViewData["Title"] = "سان سرویس > مدیریت کاربران > لیست کاربران";
}
@model List< UserSummaryDto>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="col-lg-12">
    <div class="portlet box shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    کاربران
                </h3>
            </div><!-- /.portlet-title -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            <div class="top-buttons-box mb-2">
                <a class="btn btn-success"  asp-controller="Users" asp-action="Create">
                    <i class="icon-plus"></i>
                    افزودن
                    <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                </a>
            </div>
            <div class="row">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped" id="user-table">
                        <thead>
                            <tr>
                               @*  <th class="p-low"><input type="checkbox" id="btn-check-all-toggle"></th> *@

                                <th>شناسه</th>
                                <th>عکس</th>
                                <th>نام</th>
                                <th>نام خانوادگی</th>
                                <th>نام کاربری</th>
                                <th>موبایل</th>
                                <th>ایمیل</th>
                                <th>شهر</th>
                                <th>نقش</th>
                                <th>وضعیت  کاربر</th>

                                <th>عملیات</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model)
                            {
                                <tr>
                                  
                                    <td>@user.Id</td>


                                    @if (string.IsNullOrEmpty(user.ImagePath))
                                    {
                                        <td><img style="border-radius : 50%" src="~/images/Profiles/default-profile.jpg" width="80" height="80" class="d-block mx-auto" /></td>
                                    }
                                    else
                                    {

                                        <td><img src="@user.ImagePath" width="80" height="80" style="border-radius : 50%" class="d-block mx-auto"></td>
                                    }

                                    <td>@user.FirstName</td>
                                    <td>@user.LastName</td>
                                    <td>@user.UserName</td>
                                    <td>@user.Mobile</td>
                                    <td>@user.Email</td>
                                    <td>@user.City</td>
                                    <td> @EnumExtensionMethods.GetEnumDisplayName(user.Role)</td>

                                    <td>
                                       
                                            @if (user.StatusUser)
                                            {
                                                <form asp-action="DeActiveUser" asp-controller="Users" asp-route-id="@user.Id" value="@user.StatusUser"><button type="submit" class="badge bg-success">فعال</button></form>
                                            }
                                        

                                       
                                            else
                                            {
                                                <form asp-action="ActiveUser" asp-controller="Users" asp-route-id="@user.Id" value="@user.StatusUser"><button type="submit" class="badge bg-warning"> غیرفعال</button></form>
                                            }
                                        

                                    </td>
                                   
                                    <td>
                                        <a asp-controller="Users" asp-action="Update" asp-route-Id="@user.Id" class="btn btn-info ">
                                           
                                            ویرایش
                                        </a>
                                        <a onclick="return confirm('آیا از حذف این کاربر اطمینان دارید؟')" asp-action="Delete" asp-route-Id="@user.Id" class="btn btn-danger ">حذف</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-lg-12 -->
@section Scripts
{
    <script src="~/AdminTemplate/plugins/data-table/js/jquery.dataTables.min.js"></script>
    <script src="~/AdminTemplate/js/pages/datatable.js"></script>
}
