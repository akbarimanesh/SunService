                        @using SunService.Domain.Core.SunServices.BaseEntities.AppServices
@using SunService.Domain.Core.SunServices.UserS.Enums
@using SunService.EndPoints.Mvc.Task.Areas.Admin.Models
@{
    ViewData["Title"] = "سان سرویس > مدیریت کاربران > ویرایش کاربر";

}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model UpdateViewModel
@inject IBaseDataAppService BaseDataAppService;
@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="col-lg-12">
    <div class="portlet box shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    کاربران
                </h3>
            </div><!-- /.portlet-title -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            <div class="top-buttons-box mb-2">
            </div>
            <div class="row">
                <form asp-action="Update" enctype="multipart/form-data" id="simple-form" role="form" method="post">
                    @* <img style="border-radius : 50%" src="@Model.User.ImagePath" width="80" height="80" /> *@
                    <hr />
                    <input type="hidden" asp-for="Id" />

                    <div class="form-body">
                        <div class="form-group">
                            <div class="input-group">
                                <input asp-for="FirstName" asp-controller="Users" asp-action="Update" class="form-control" type="text" value="@Model.FirstName" placeholder="نام">
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="input-group">
                                <input asp-for="LastName" asp-controller="Users" asp-action="Update" class="form-control" type="text" value="@Model.LastName" placeholder="نام خانوادگی">
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="input-group">
                                <input asp-for="Mobile" asp-controller="Users" asp-action="Update" class="form-control" type="text" placeholder="شماره موبایل" value="@Model.Mobile" />
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="input-group">
                                <input asp-for="Email" asp-controller="Users" asp-action="Update" class="form-control" type="email" placeholder="آدرس ایمیل" value="@Model.Email" />
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="input-group">
                                <input asp-for="Address" asp-controller="Users" asp-action="Update" class="form-control" type="text" placeholder="آدرس" value="@Model.Address" />
                            </div>
                        </div>


                        <div class="form-group">
                            <div class="input-group">
                                <input asp-for="Username" asp-controller="Users" asp-action="Update" class="form-control" type="text" placeholder="نام کاربری" value="@Model.Username" />
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="input-group">
                                <select asp-for="cityId" class="form-select" value="@Model.cityId">
                                    @foreach (var city in await @BaseDataAppService.GetCities(default))
                                    {
                                        <option value="@city.Id">@city.Title</option>
                                    }
                                </select>
                            </div>
                        </div>

                        <div class="form-group">
                            <div class="input-group">
                                <select placeholder="انتخاب نقش" asp-for="RoleId" asp-items="Html.GetEnumSelectList<RoleEnum>()"><option value="">انتخاب نقش</option></select>
                               
                            </div>
                        </div>
                        <span>کاربر فعال شود؟</span>
                        <input asp-for="Statuse" asp-controller="Users" asp-action="Update" class="task-checkbox" type="checkbox" placeholder="وضعیت" value="True" />
                        <div class="form-group relative">
                            <input asp-for="ProfileImgFile" type="file" class="form-control">
                            <label>آپلود عکس</label>
                            <div class="input-group round">
                                <input type="text" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
                                <span class="input-group-btn">
                                    <button type="button" class="btn btn-success">
                                        <i class="icon-picture"></i>
                                        آپلود عکس
                                        <div class="paper-ripple">
                                            <div class="paper-ripple__background"></div>
                                            <div class="paper-ripple__waves"></div>
                                        </div>
                                    </button>
                                </span>
                            </div><!-- /.input-group -->
                            <div class="help-block"></div>
                        </div>

                    </div>
                    <hr>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-success">
                            <i class="icon-check"></i>
                            ذخیره
                        </button>
                        <a asp-action="Index" class="btn btn-warning">
                            بازگشت
                        </a>
                    </div>
                    @if (ViewBag.SuccessMessage != null)
                    {
                        <div class="alert alert-success">@ViewBag.SuccessMessage</div>
                    }
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                    }

                </form>
            </div>
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}