@using Framework
@using SunService.Domain.Core.SunServices.HService.DTOs
@using SunService.Domain.Core.SunServices.UserS.DTOs
@{
    ViewData["Title"] = "سان سرویس > مدیریت سفارش ها > لیست سفارش ";
}
@model List<OrderDto>
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="col-lg-12">
    <div class="portlet box shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                    سفارش
                </h3>
            </div><!-- /.portlet-title -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            @* <div class="top-buttons-box mb-2">
                <a class="btn btn-success" asp-controller="Orders" asp-action="Create">
                    <i class="icon-plus"></i>
                    افزودن
                    <div class="paper-ripple"><div class="paper-ripple__background"></div><div class="paper-ripple__waves"></div></div>
                </a>
            </div> *@
            <div class="row">
                <div class="table-responsive">
                    <table class="table table-bordered table-hover table-striped" id="order-table">
                        <thead>
                            <tr>


                                <th>شناسه</th>
                                <th>سفارش دهنده </th>
                                <th>خدمات</th>
                                <th>تاریخ سفارش</th>
                                <th>تاریخ اجرا</th>
                                <th>ساعت اجرا</th>
                               
                                <th>وضعیت سفارش</th>
                                <th>پیشنهاد</th>
                                <th>فعال/غیرفعال</th>
                                <th>عملیات</th>

                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>

                                    <td>@order.Id</td>
                                    <td>@order.CustomerFullName</td>
                                    <td>@order.HomeServiceTitle </td>
                                    <td>@order.CreateAt.ToPersianString("yyyy/MM/dd")</td>
                                    <td>@order.ImplementationDate.ToPersianString("yyyy/MM/dd")</td>
                                    <td>@order.ImplementationTime.ToString("HH:mm")</td>
                                   
                                    
                                    <td>@EnumExtensionMethods.GetEnumDisplayName(order.OrderHomeServiceStatus) </td>


                                    <td>
                                        <a asp-controller="Offers" asp-action="Index" asp-route-Id="@order.Id" class="btn btn-success">پیشنهادها</a>
                                    </td>
                                 
                                    <td>
                                        @if (order.StateOrder)
                                        {
                                            <form asp-action="DeActiveOrder" asp-controller="Orders" asp-route-id="@order.Id" value="@order.StateOrder"><button type="submit" class="badge bg-success">فعال</button></form>
                                        }



                                        else
                                        {
                                            <form asp-action="ActiveOrder" asp-controller="Orders" asp-route-id="@order.Id" value="@order.StateOrder"><button type="submit" class="badge bg-warning"> غیرفعال</button></form>
                                        }
                                    </td>
                                   <td>
                                        <a asp-controller="Orders" asp-action="Update" asp-route-Id="@order.Id" class="btn btn-info">وضعیت</a>
                                       @*  <a onclick="return confirm('آیا از حذف این سفارش اطمینان دارید؟')" asp-action="Delete" asp-route-Id="@order.Id" class="btn btn-danger">حذف</a> *@
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!-- /.col-lg-12 -->
@section Scripts
{
    <script src="~/AdminTemplate/plugins/data-table/js/jquery.dataTables.min.js"></script>
    <script src="~/AdminTemplate/js/pages/datatable.js"></script>
}

