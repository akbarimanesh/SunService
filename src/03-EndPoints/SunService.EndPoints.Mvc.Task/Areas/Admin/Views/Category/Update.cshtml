@using SunService.Domain.Core.SunServices.HService.DTOs
@using SunService.Domain.Core.SunServices.HService.Entities
@using SunService.EndPoints.Mvc.Task.Areas.Admin.Models


@{
    ViewData["Title"] = "سان سرویس > مدیریت دسته بندی ها > ویرایش دسته بندی ";

}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model CategoryViewModel

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}

<div class="col-lg-12">
    <div class="portlet box shadow">
        <div class="portlet-heading">
            <div class="portlet-title">
                <h3 class="title">
                     دسته بندی ها
                </h3>
            </div><!-- /.portlet-title -->
        </div><!-- /.portlet-heading -->
        <div class="portlet-body">
            <div class="top-buttons-box mb-2">
            </div>
            <div class="row">
                <form asp-action="Update" enctype="multipart/form-data" id="simple-form" role="form" method="post">
                    @* <img style="border-radius : 50%" src="@Model.User.ImagePath" width="80" height="80" /> *@
                    <hr />
                    <input type="hidden" asp-for="Id" />

                    <div class="form-body">
                        <div class="form-group">
                            <div class="input-group">
                                <input asp-for="Title" asp-controller="Category" asp-action="Update" class="form-control" type="text" value="@Model.Title" placeholder="عنوان">
                            </div>
                        </div>

                         <div class="form-group relative">
                            <input asp-for="ProfileImgFile" type="file" class="form-control">
                            <label>آپلود عکس</label>
                            <div class="input-group round">
                                <input type="text" class="form-control file-input" placeholder="برای آپلود کلیک کنید">
                                <span class="input-group-btn">
                                    <button type="button" class="btn btn-success">
                                        <i class="icon-picture"></i>
                                        آپلود عکس
                                        <div class="paper-ripple">
                                            <div class="paper-ripple__background"></div>
                                            <div class="paper-ripple__waves"></div>
                                        </div>
                                    </button>
                                </span>
                            </div><!-- /.input-group -->
                            <div class="help-block"></div>
                        </div>

                    </div>
                    <hr>
                    <div class="form-actions">
                        <button type="submit" class="btn btn-success">
                            <i class="icon-check"></i>
                            ذخیره
                        </button>
                        <a asp-action="Index" class="btn btn-warning">
                            بازگشت
                        </a>
                    </div>
                    @if (ViewBag.SuccessMessage != null)
                    {
                        <div class="alert alert-success">@ViewBag.SuccessMessage</div>
                    }
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-danger">@ViewBag.ErrorMessage</div>
                    }

                </form>
            </div>
        </div><!-- /.portlet-body -->
    </div><!-- /.portlet -->
</div><!
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}

