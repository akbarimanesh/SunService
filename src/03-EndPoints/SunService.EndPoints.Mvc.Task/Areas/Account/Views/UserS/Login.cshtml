@using SunService.Domain.AppServices.SunServices.BaseEntities
@using SunService.Domain.Core.SunServices.BaseEntities.AppServices
@using SunService.Domain.Core.SunServices.UserS.Enums
@using SunService.EndPoints.Mvc.Task.Areas.Account.Models
@{
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model LoginViewModel
@{
    ViewData["Title"] = "ورود ";
}

<div class="page">
    
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }

    @await Html.PartialAsync("_TitlePage")
    <div class="user-area pt-100 pb-70">
        <div class="container">
            <div class="row justify-content-center">
                <!-- مرکز چین کردن ستون -->
                <div class="col-lg-6 d-flex justify-content-center">
                    <!-- تنظیم ستون وسط -->
                    <div class="user-all-form w-100">
                        <div class="contact-form">
                            <h3 class="text-center"> وارد شوید</h3> <!-- عنوان وسط چین -->
                            <div class="bar"></div>
                            <form id="contactForm" method="post" asp-area="Account" asp-controller="UserS" asp-action="Login">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label>نام کاربری</label>
                                            <input type="text" asp-for="Username" class="form-control" required data-error="لطفا نام کاربری وارد کنید">
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>گذرواژه</label>
                                            <input class="form-control" type="password" asp-for="Password">
                                        </div>
                                    </div>
                                    <div class="col-lg-12 col-md-12 text-center">
                                        <button type="submit" class="default-btn">
                                            وارد شوید
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div> <!-- پایان col-lg-6 -->
            </div> <!-- پایان row -->
        </div>
    </div>
        </div>
        

    @section Scripts
    {
        <partial name="_ValidationScriptsPartial" />
    }
