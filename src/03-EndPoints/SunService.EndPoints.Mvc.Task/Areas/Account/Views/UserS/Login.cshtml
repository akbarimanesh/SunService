@using SunService.Domain.AppServices.SunServices.BaseEntities
@using SunService.Domain.Core.SunServices.BaseEntities.AppServices
@using SunService.Domain.Core.SunServices.UserS.Enums
@using SunService.EndPoints.Mvc.Task.Areas.Account.Models

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@model LoginViewModel
@{
    ViewData["Title"] = "ورود ";
}



@await Html.PartialAsync("_TitlePage")
<div class="page">

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
 @if (!User.Identity.IsAuthenticated)
 { 
    <div class="user-area pt-100 pb-70">
        <div class="container">
            <div class="row justify-content-center">
              
                <div class="col-lg-6 d-flex justify-content-center">
                 
                    <div class="user-all-form w-100">
                        <div class="contact-form">
                            <h3 class="text-center"> وارد شوید</h3> 
                            <div class="bar"></div>
                            <form  method="post" asp-action="Login">
                                <div class="row">
                                    <div class="col-lg-12">
                                        <div class="form-group">
                                            <label>نام کاربری</label>
                                            <input type="text" asp-for="Username" class="form-control" >
                                            <span class="text-danger" asp-validation-for="Username"></span>
                                        </div>
                                    </div>
                                    <div class="col-12">
                                        <div class="form-group">
                                            <label>رمز عبور</label>
                                            <input class="form-control" type="password" asp-for="Password">
                                            <span class="text-danger" asp-validation-for="Password"></span>
                                        </div>
                                    </div>
                                    <div class="col-lg-12 col-md-12 text-center">
                                        <button type="submit" class="default-btn">
                                            وارد شوید
                                        </button>
                                    </div>
                                        <div class="col-lg-12 col-md-12 text-center">
                                            <br />
                                            <a  asp-controller="UserS" asp-action="Register" class="default-btn two border-radius-5">ثبت نام کنید <i class="ri-user-add-line"></i></a>
                                        </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div> <!-- پایان col-lg-6 -->
            </div> <!-- پایان row -->
        </div>
    </div>
    }
    @* else
    {
        <div>
            <h4>Welcome @User.Identity.Name</h4>

        </div>
    } *@
        </div>
        

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
