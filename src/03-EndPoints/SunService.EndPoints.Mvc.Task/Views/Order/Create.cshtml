@using SunService.Domain.Core.SunServices.HService.AppServices
@using SunService.Domain.Core.SunServices.HService.DTOs
@using SunService.Domain.Core.SunServices.HService.Services

@{
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "ارسال سفارش ";
}

@model OrderViewModel

@await Html.PartialAsync("_TitlePage")
<div class="page">
    @inject IHomeServiceAppServices _HomeServiceAppServices;
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
    @if (User.Identity.IsAuthenticated)
    {
        <div class="post-job-area pt-100 pb-70">
            <div class="container">
                <div class="post-job-form">
                    <h2>ثبت درخواست خدمات جدید</h2>
                    <div class="bar"></div>
                    <div class="contact-form">
                      @*   <h3>اطلاعات پایه</h3> *@
                        <form asp-controller="Order" asp-area="" asp-action="Create" method="post" enctype="multipart/form-data">
                            <div class="row">
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>خدمات</label>
                                        <input type="hidden" asp-for="@Model.orderDto.HomeserviceId" />
                                        <select asp-for="@Model.orderDto.HomeserviceId" asp-controller="HomeService" asp-action="Create" class="form-select form-control" >
                                        @foreach (var homeservice in Model.HomeServices)
                                        {
                                       
                                                
                                                <option value="@homeservice.Id">@homeservice.Title</option>
                                                
                                            
                                        }
                                        </select>
                                    </div>
                                </div>


                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>تاریخ اجرا</label>
                                        <input asp-for="@Model.orderDto.ImplementationDate" type="text" class="form-control" placeholder="تاریخ اجرا" data-jdp>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="form-group">
                                        <label>ساعت اجرا</label>
                                        <input asp-for="@Model.orderDto.ImplementationTime" class="form-control" id="flatpickr-time" placeholder="HH:MM" type="text" />
                                      @*   <input name="msg_subject" class="form-control" required data-error="لطفا ساعت را وارد کنید" placeholder="12:00" > *@
                                    </div>
                                </div>
                                
                                <div class="col-lg-12 col-md-12">
                                    <div class="form-group">
                                        <label>توضیحات</label>
                                        <textarea asp-for="@Model.orderDto.Description" class="form-control" cols="30" rows="5"></textarea>
                                    </div>
                                </div>
                                <div class="col-lg-12">
                                    <div class="choose-img">
                                        <p class="title">آپلود تصاویر</p>
                                        <input asp-for="@Model.orderDto.Images" type="file"  multiple>
                                        <p>حداکثر حجم فایل: 2 مگابایت</p>
                                    </div>
                                </div>
                                <div class="col-lg-12 col-md-12">
                                    <button type="submit" class="default-btn border-radius-5">
                                        ارسال  <i class="ri-chat-4-line"></i>
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                   
                    
                </div>
            </div>
        </div>
    }
    else
    {
        <script type="text/javascript">
            window.location.href = '@Url.Content("~/Account/UserS/Login")';
        </script>
    }
   

   
    @section Scripts
    {
        <partial name="_ValidationScriptsPartial" />
    }
  
