@using SunService.Domain.Core.SunServices.HService.DTOs
@{
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "زیردسته بندی ها";
}

@model List<SubCategoryDto>
@await Html.PartialAsync("_TitlePage")
<div class="page">

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    <div class="container">
        <div class="candidates-skill p-5 shadow-lg rounded bg-white text-center">
            <h3 class="mb-4 fw-bold text-success">@ViewData["CategoryName"]</h3>
            <div class="bar mb-4"></div>

            <ul class="candidates-skill-tag d-flex flex-wrap justify-content-center p-0">
                @foreach (var subcategory in Model)
                {
                    <li class="subcategory-item m-2">
                        <a asp-controller="HomeService" asp-action="SubCategoryHomeServices" asp-route-subCategoryId="@subcategory.Id"
                           class="subcategory-link px-4 py-2">
                            @subcategory.Title
                        </a>
                    </li>
                }
            </ul>
        </div>
    </div>


    <style>
        .container {
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 75vh; 
           }

        .candidates-skill {
            background: #00CA99;
            border-radius: 20px; 
            box-shadow: 0px 4px 8px rgba(0, 0, 0, 0.1); 
            width: 80%;
        }

      
        .subcategory-link {
            background: #2fbaa7;
            color: white;
            border-radius: 20px;
            transition: all 0.3s ease-in-out;
            font-size: 1rem;
            font-weight: 500;
            display: inline-block;
            text-decoration: none;
        }

           
            .subcategory-link:hover {
                background: #00CA99; 
                transform: translateY(-3px); 
                box-shadow:  0px 0px 10px 0px rgba(29, 184, 68, 0.5);
            }

    
        .subcategory-item {
            list-style: none;
        }
    </style>



</div>

