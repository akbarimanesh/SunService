@using SunService.Domain.Core.SunServices.HService.AppServices
@using SunService.Domain.Core.SunServices.HService.DTOs
@{
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "خدمات ";
}

@model HomePageViewModel
@await Html.PartialAsync("_TitlePage")
<div class="page">
    @inject IHomeServiceAppServices _HomeServiceAppServices;
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }
   @*  @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    } *@
    <div class="find-jobs-area-pageservice pt-100 pb-70">
        <div class="container">
            <div class="job-listing-top">
                <div class="row align-items-center">
                    <div class="col-lg-12">
                        <div class="job-listing-form">
                            <form>
                                <div class="row align-items-center">
                                    <div class="col-lg-6 col-sm-12">
                                        <div class="form-group">
                                            <input class="form-control" type="text" name="title" placeholder="عنوان خدمات">
                                            <i class="ri-search-line"></i>
                                        </div>
                                    </div>


                                   
                                    <div class="col-lg-6 col-md-12">
                                        <button type="submit" class="submit-btn border-radius-5">
                                            جستجوی خدمات
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            <div class="find-jobs-area-pageservice pt-100 pb-70">
                <div class="container">

                    <div class="row pt-45">
                        @if (Model.homeServiceDtos.Any())
                        {
                            @foreach (var item in Model.homeServiceDtos)
                            {
                                <div class="col-lg-12">
                                    <div class="find-jobs-card d-flex align-items-center">
                                        <div class="find-jobs-img">
                                            <a href="job-details.html">
                                                <img src="@item.ImagePath" alt="@item.Title">
                                            </a>
                                        </div>
                                        <div class="content">
                                            <h3><a href="job-details.html">@item.Title</a></h3>
                                            <ul class="content-list3">
                                                <li><i class="ri-briefcase-line"></i> زیر دسته بندی : <b>@item.SubCategoryTitle</b></li>
                                                <li><i class="ri-currency-line"></i>قیمت پایه : <b>@item.BasePrice</b></li>
                                            </ul>
                                        </div>
                                        <div class="find-jobs-btn">
                                            <a asp-controller="Order" asp-action="Create" asp-route-Id="@item.Id" class="default-btn border-radius-5">ثبت سفارش<i class="ri-send-plane-2-line"></i></a>
                                              
                                           
                                        </div>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="col-lg-12">
                                <p class="text-center text-danger">هیچ نتیجه‌ای یافت نشد!</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="col-lg-12 col-md-12 text-center">
                <div class="pagination-area">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })" class="prev page-numbers">
                            <i class="ri-arrow-right-s-line"></i>
                        </a>
                    }

                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.CurrentPage)
                        {
                            <span class="page-numbers current">@i</span>
                        }
                        else
                        {
                            <a href="@Url.Action("Index", new { page = i })" class="page-numbers">@i</a>
                        }
                    }

                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Url.Action("Index", new { page = Model.CurrentPage + 1 })" class="next page-numbers">
                            <i class="ri-arrow-left-s-line"></i>
                        </a>
                    }
                </div>
            </div>

        </div>
    </div>
</div>
</div>

