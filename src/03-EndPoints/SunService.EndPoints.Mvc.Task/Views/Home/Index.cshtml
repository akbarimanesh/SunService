@using SunService.Domain.Core.SunServices.UserS.Enums
@model HomePageViewModel

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
}
<div class="banner-area">
    <div class="container-fluid">
        <div class="row align-items-center">
            <div class="col-lg-7">
                <div class="banner-content">

                    <div class="banner-form wow fadeInLeft" data-wow-delay="200ms" data-wow-duration="1000ms">
                        <form asp-controller="Home" asp-action="Search" >
                            <div class="row">
                                <div class="col-lg-8 col-sm-12">
                                    <div class="form-group">
                                        <input class="form-control" type="text" name="title" placeholder="عنوان خدمات">
                                        <i class="ri-search-line"></i>
                                    </div>
                                </div>

                               

                                <div class="col-lg-4 col-sm-12">
                                    <button type="submit" class="submit-btn border-radius-5">
                                        جستجوی خدمات
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>


                </div>
            </div>
            <div class="col-lg-5">
                <div class="banner-img">
                    <img src="~/UserTemplate/images/home-one/home-one-img.png" alt="Banner Images" class="wow fadeInUp" data-wow-delay="000ms" data-wow-duration="1000ms">
                    <div class="banner-img-shape">
                        <div class="shape1 wow fadeInUp" data-wow-delay="100ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <a href="#">
                                <img src="~/UserTemplate/images/home-one/home-one-icon3.png" alt="Image">
                            </a>
                        </div>
                        <div class="shape2 wow fadeInUp" data-wow-delay="200ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <img src="~/UserTemplate/images/home-one/user1.jpg" alt="Image">
                        </div>
                        <div class="shape3 wow fadeInUp" data-wow-delay="300ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <img src="~/UserTemplate/images/home-one/user2.jpg" alt="Image">
                        </div>
                        <div class="shape4 wow fadeInUp" data-wow-delay="400ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <a href="#">
                                <img src="~/UserTemplate/images/home-one/home-one-icon1.png" alt="Image">
                            </a>
                        </div>
                        <div class="shape5 wow fadeInUp" data-wow-delay="500ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <img src="~/UserTemplate/images/home-one/user2.jpg" alt="Image">
                        </div>
                        <div class="shape6 wow fadeInUp" data-wow-delay="500ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <a href="#">
                                <img src="~/UserTemplate/images/home-one/home-one-icon2.png" alt="Image">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="banner-shape">
        <div class="shape-in-one">
            <img src="~/UserTemplate/images/home-one/shape1.png" alt="Images">
        </div>
        <div class="shape-in-two">
            <img src="~/UserTemplate/images/home-one/shape2.png" alt="Images">
        </div>
    </div>
</div>


<div class="browse-jobs-area pt-100 pb-70">
    <div class="container">
        <div class="section-title text-center">
            <h2>خدمات آنلاین و تعمیرات در منزل با سان</h2>
            <div class="bar m-auto"></div>
          @*   <p class="m-auto">در حال حاضر 13 خدمات در سان موجود می باشد.</p> *@
        </div>
        <div class="row pt-45">


            @foreach (var category in Model.categoryDtos)
            {
                <div class="col-lg-3 col-6">
                    <div class="browse-jobs-item">
                        <img src="@category.ImagePath" alt="@category.Title" width="80" height="80" class="jobs-card-img">

                        <h3><a asp-controller="SubCategories" asp-action="Index" asp-route-categoryId="@category.Id">@category.Title</a></h3>
                    </div>
                </div>
            }


            



            <div class="col-lg-12 text-center">
                <div class="browse-btn">
                    <a href="~/Categories/Index"> همه دسته ها را مرور کنید <i class="ri-arrow-left-s-line"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="find-jobs-area pt-100 pb-70">
    <div class="container">
        <div class="row pt-45">
            @foreach (var item in @Model.homeServiceDtos)
            {
                <div class="col-lg-12">
                    <div class="find-jobs-card d-flex align-items-center">
                        <div class="find-jobs-img">
                            <a href="job-details.html">
                                <img src="@item.ImagePath" alt="@item.Title">
                            </a>
                        </div>
                        <div class="content">

                            <h3><a href="job-details.html">@item.Title</a></h3>
                            <ul class="content-list2">
                            </ul>
                            <ul class="content-list3">
                                 <li><i class="ri-map-pin-line"></i> دسته بندی : <b>@item.CategoryTitle</b></li>
                                <li><i class="ri-briefcase-line"></i> زیر دسته بندی : <b>@item.SubCategoryTitle</b></li>

                                <li><i class="ri-currency-line"></i>قیمت پایه : <b>@item.BasePrice</b></li>
                            </ul>
                        </div>
                        <div class="find-jobs-btn">
                            <a asp-controller="Order" asp-action="Create" asp-route-Id="@item.Id"  class="default-btn border-radius-5">ثبت سفارش<i class="ri-send-plane-2-line"></i></a>
                        </div>

                    </div>
                </div>
            }



            <div class="col-lg-12 text-center">
                <div class="browse-btn">
                    <a href="~/HomeService/Index"> خدمات بیشتر را بارگیری کنید <i class="ri-arrow-left-s-line"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>


