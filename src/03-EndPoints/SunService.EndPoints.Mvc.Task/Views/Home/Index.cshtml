                        </div>
                        <div class="shape3 wow fadeInUp" data-wow-delay="300ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <img src="~/UserTemplate/images/home-one/user2.jpg" alt="Image">
                        </div>
                        <div class="shape4 wow fadeInUp" data-wow-delay="400ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <a href="#">
                                <img src="~/UserTemplate/images/home-one/home-one-icon1.png" alt="Image">
                            </a>
                        </div>
                        <div class="shape5 wow fadeInUp" data-wow-delay="500ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <img src="~/UserTemplate/images/home-one/user2.jpg" alt="Image">
                        </div>
                        <div class="shape6 wow fadeInUp" data-wow-delay="500ms" data-wow-duration="1000ms" data-speed="0.08" data-revert="true">
                            <a href="#">
                                <img src="~/UserTemplate/images/home-one/home-one-icon2.png" alt="Image">
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="banner-shape">
        <div class="shape-in-one">
            <img src="~/UserTemplate/images/home-one/shape1.png" alt="Images">
        </div>
        <div class="shape-in-two">
            <img src="~/UserTemplate/images/home-one/shape2.png" alt="Images">
        </div>
    </div>
</div>


<div class="browse-jobs-area pt-100 pb-70">
    <div class="container">
        <div class="section-title text-center">
            <h2>خدمات آنلاین و تعمیرات در منزل با سان</h2>
            <div class="bar m-auto"></div>
          @*   <p class="m-auto">در حال حاضر 13 خدمات در سان موجود می باشد.</p> *@
        </div>
        <div class="row pt-45">


            @foreach (var category in Model.categoryDtos)
            {
                <div class="col-lg-3 col-6">
                    <div class="browse-jobs-item">
                        <img src="@category.ImagePath" alt="@category.Title" width="80" height="80" class="jobs-card-img">

                        <h3><a asp-controller="SubCategories" asp-action="Index" asp-route-categoryId="@category.Id">@category.Title</a></h3>
                    </div>
                </div>
            }


            



            <div class="col-lg-12 text-center">
                <div class="browse-btn">
                    <a href="~/Categories/Index"> همه دسته ها را مرور کنید <i class="ri-arrow-left-s-line"></i></a>
                </div>
            </div>
        </div>
    </div>
</div>


<div class="find-jobs-area pt-100 pb-70">
