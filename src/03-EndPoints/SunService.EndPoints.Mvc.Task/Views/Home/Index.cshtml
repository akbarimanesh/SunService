@{
    var groupedExperts = Model.ratingDtos
        .GroupBy(r => new { r.ExpertFullName, r.HomeServiceTitle, r.ImagePathEXpert, r.Status })
        .Select(g => new
        {
            ExpertFullName = g.Key.ExpertFullName,
            HomeServiceTitle = g.Key.HomeServiceTitle,

            ImagePathEXpert = g.Key.ImagePathEXpert,
            Status = g.Key.Status,
            AverageRating = g.Average(r => r.AverageRating) 
        })
        .OrderByDescending(e => e.AverageRating) 
        .ToList();
}

<div class="freelancers-area pt-100 pb-70">
    <div class="container">
        <div class="section-title text-center">
            <h2>کارشناس های دارای بالاترین امتیاز</h2>
            <div class="bar m-auto"></div>
        </div>

        <div class="row pt-45 justify-content-center">
            @foreach (var item in groupedExperts)
            {
               
               
                 @if (item.Status == StatuseRating.aproved) 
                {
                    <div class="col-lg-4 col-sm-6">
                        <div class="freelancers-card">
                            <a href="freelancer.html">
                                @if (string.IsNullOrEmpty(item.ImagePathEXpert))
                                {
                                    <img style="border-radius: 50%" src="~/images/Profiles/default-profile.jpg" width="80" height="80" class="d-block mx-auto" />
                                }
                                else
                                {
                                    <img style="border-radius: 50%" src="@item.ImagePathEXpert" width="80" height="80" class="d-block mx-auto" />
                                }
                            </a>
                            <div class="title">
                                <h3>
                                    <a href="freelancer.html">@item.ExpertFullName</a>
                                </h3>
                            </div>
                            <p>@item.HomeServiceTitle</p>
                            <div class="rating">
                                <span class="stars">
                                    @{
                                        int roundedRating = (int)Math.Round(item.AverageRating);
                                    }
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        <span class="@(i <= roundedRating ? "star-filled" : "star-empty")">★</span>
                                    }
                                </span>
                            </div>
                            <div class="sub-title">
                                <span class="sub-title2">میانگین امتیاز : <b>@item.AverageRating.ToString("0.0")</b></span>
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>

<style>
    .star-filled {
        color: gold;
        font-size: 18px;
    }

    .star-empty {
        color: lightgray;
        font-size: 18px;
    }
</style>


