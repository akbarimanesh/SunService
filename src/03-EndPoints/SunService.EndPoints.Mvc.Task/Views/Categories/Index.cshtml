@using SunService.Domain.Core.SunServices.HService.DTOs
@{
    Layout = "_Layout";
}
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "دسته بندی ";
}

@model List<CategoryDto>
@await Html.PartialAsync("_TitlePage")
<div class="page">

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <ul>
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <li>@error.ErrorMessage</li>
                }
            </ul>
        </div>
    }
    <div class="company-area pt-100 pb-70">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-lg-8">
                    <div class="section-title">
                        <h2>دسته بندی سان سرویس</h2>
                        <div class="bar"></div>
                       
                    </div>
                </div>
                
            </div>
            <div class="row pt-45">

                <div class="browse-jobs-area pt-100 pb-70">
                    <div class="container">
                        <div class="section-title text-center">
                            <h2>خدمات آنلاین و تعمیرات در منزل با سان</h2>
                            <div class="bar m-auto"></div>
                            @*   <p class="m-auto">در حال حاضر 13 خدمات در سان موجود می باشد.</p> *@
                        </div>
                        <div class="row pt-45">




                            @foreach (var category in Model)
                            {
                                <div class="col-lg-3 col-6">
                                    <div class="browse-jobs-item">
                                        <img src="@category.ImagePath" alt="@category.Title" width="80" height="80" class="jobs-card-img">

                                        <h3><a asp-controller="SubCategories" asp-action="Index" asp-route-categoryId="@category.Id">@category.Title</a></h3>
                                    </div>
                                </div>
                            }



                           @*  <div class="col-lg-12 col-md-12 text-center">
                                <div class="pagination-area">
                                    @if (@Model.CurrentPage > 1)
                                    {
                                        <a href="@Url.Action("Index", new { page = Model.CurrentPage - 1 })" class="prev page-numbers">
                                            <i class="ri-arrow-right-s-line"></i>
                                        </a>
                                    }

                                    @for (int i = 1; i <= Model.TotalPages; i++)
                                    {
